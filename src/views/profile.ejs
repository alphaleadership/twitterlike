<div class="container">
    <%- include('partials/sidebar', { sidebarAccounts: topMentionedAccounts || [], favoriteAccounts: favoriteAccounts || [], searchQuery: searchQuery }) %>
    <div class="main-content">
        <h1>Profil de <%= user.username %></h1>
        <p><a href="/">Retour à l'accueil</a></p>
        <% if (isLoggedIn) { %>
            <div class="profile-actions">
                <form action="/like-all-tweets/<%= user.username %>" method="post" style="display: inline;">
                    <button type="submit" class="btn">Liker tous les tweets</button>
                </form>
                <form action="/like-all-media-tweets/<%= user.username %>" method="post" style="display: inline;">
                    <button type="submit" class="btn">Liker tous les médias</button>
                </form>
            </div>
        <% } %>
        
        <div class="profile-nav">
            <a href="/profile/<%= user.username %>" class="active">Tweets</a>
            <a href="/profile/<%= user.username %>/media">Médias</a>
            <a href="/profile/<%= user.username %>/videos">Vidéos</a>
        </div>
        
        <div id="tweetListContainer">
            <%- include('partials/tweetList', { tweets: tweets, isLoggedIn: isLoggedIn }) %>
        </div>
        <%- include('partials/pagination', { currentPage: currentPage, totalPages: totalPages, baseUrl: '/profile/' + user.username, search: searchQuery }) %>
    </div>
</div>