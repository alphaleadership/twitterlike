<div class="container">
    <%- include('partials/sidebar', { sidebarAccounts: typeof allAccounts !== 'undefined' ? allAccounts : [], favoriteAccounts: typeof favoriteAccounts !== 'undefined' ? favoriteAccounts : [] }) %>
    <div class="main-content">
        <h1>Médias des comptes favoris</h1>
        
        <div class="media-grid">
            <% if (media && media.length > 0) { %>
                <% media.forEach(tweet => { %>
                    <div class="media-item">
                        <% if (tweet.allMedia && tweet.allMedia.length > 0) { %>
                            <% if (tweet.allMedia[0].type === 'video') { %>
                                <video src="<%= tweet.allMedia[0].lien %>" controls></video>
                            <% } else { %>
                                <img src="<%= tweet.allMedia[0].locallien %>" alt="Média">
                            <% } %>
                        <% } %>
                        <div class="media-info">
                            <a href="/profile/<%= tweet.compte %>" class="username">@<%= tweet.compte %></a>
                            <a href="/tweet/<%= tweet.id %>" class="view-tweet">Voir le tweet</a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p>Aucun média trouvé.</p>
            <% } %>
        </div>
        
        <%- include('partials/pagination', { currentPage: currentPage, totalPages: totalPages, baseUrl: '/favorite_accounts_media' }) %>
    </div>
</div>